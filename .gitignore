# 후기가 들어 있는 DB 파일은 깃에 올리지 않는다 (손님의 닉네임과 후기가 공개되고, 내 DB와 서버 DB가 충돌한다)
*.db
# 비밀번호와 키를 적어 두는 파일
.env
# 파이썬이 만드는 임시 파일
__pycache__/

# ---- 배포에 필요 없는 것들 (내 컴퓨터에는 그대로 있고, 깃에만 안 올린다) ----
# 앞의 /는 "이 저장소 맨 위 폴더 바로 아래의 것"이라는 뜻이다
# 지울 파일을 모아 둔 폴더
/delete/
# 강의 자료(카드, 체크리스트, zip)
/자료/
# 연습 예제 폴더
/flask-연습/
/flask-연습2/
# 앱이 쓰지 않는 CSV는 올리지 않고, 앱이 읽는 classes.csv만 올린다 (!는 "이건 예외"라는 뜻이다)
/data/*.csv
!/data/classes.csv
